      "required": true
    },
    {
      "system": "All-members Google Group at the org level",
      "access_required": "org-config.json must define remote_filesystem.connection.all_members_group; setup task reads this to apply the collection-wide visibility floor",
      "contact": "org admin",
      "required": true
    },
    {
      "system": "Permission-change-helper binary",
      "access_required": "mcp-servers/permission-helper-go/agent-index-show-plan (preferred) or mcp-servers/permission-helper/show-plan.sh (fallback) must be installed",
