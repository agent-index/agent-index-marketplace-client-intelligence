    {
      "system": "Remote filesystem access (access-control contract 2.0.0 or higher)",
      "access_required": "Read/write access to /shared/client-intelligence/ via aifs_* tools; per-instance permission management requires aifs_share, aifs_unshare, aifs_get_permissions, and revision-aware aifs_write (if_revision)",
